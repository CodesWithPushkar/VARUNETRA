# Oil-slick API endpoint used by the MapLibre frontend.
NEXT_PUBLIC_VARUNETRA_API_URL=https://varunetra.onrender.com/api/v1/spills

# Optional Mercator API key for the direct ocean-current overlay.
NEXT_PUBLIC_MERCATOR_API_KEY=

# Server-only Global Fishing Watch API token for reported-vessel details.
# Do not prefix this with NEXT_PUBLIC_; that would expose the token to browsers.
GFW_API_TOKEN=

# Optional backend base URL for server-side vessel API requests.
# Defaults to the base URL derived from NEXT_PUBLIC_VARUNETRA_API_URL.
# VARUNETRA_API_URL=http://localhost:3001
