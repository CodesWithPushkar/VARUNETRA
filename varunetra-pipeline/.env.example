DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
COPERNICUS_USERNAME=your-copernicus-account-email
COPERNICUS_PASSWORD=your-copernicus-account-password

# SNAP Preprocessing Hardware Allocation
SNAP_MEMORY=8G
SNAP_CACHE_SIZE=5000M
SNAP_PARALLELISM=8

# ---- Stages 6-9 (backtrack and vessel ranking) ----
# Copernicus Marine account for historical currents (separate from COPERNICUS_USERNAME above)
CMEMS_USERNAME=your-copernicus-marine-username
CMEMS_PASSWORD=your-copernicus-marine-password
# Hourly historical currents dataset id. Check it with: copernicusmarine describe -c <id>
CMEMS_CURRENTS_DATASET_ID=replace-with-verified-hourly-dataset-id
# ERA5 from the Climate Data Store (new CDS API; key from your CDS profile page)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your-cds-personal-access-token
# AIS source: neon (live ais_positions) or csv (MarineCadastre file for testing)
AIS_SOURCE=neon
AIS_CSV_PATH=
# Optional region filter for slicks, min_lon,min_lat,max_lon,max_lat (empty = all)
SLICK_BBOX=
MAX_SLICKS_PER_SCENE=5
BACKTRACK_RUNTIME_HOURS=72
BACKTRACK_N_PARTICLES=1000
BACKTRACK_WINDAGE=0.03
BACKTRACK_KH=10
BACKTRACK_DT_MINUTES=10
BACKTRACK_RANDOM_SEED=42
FORCING_PAD_DEG=3.0
FORCING_CACHE_DIR=stage-6/cache
STAGE_6_9_OUTPUT_DIR=stage-6-9/out
# Python of the Parcels 3 environment (Python 3.10-3.13), e.g. .venv-69\Scripts\python.exe
STAGE_6_9_PYTHON=
